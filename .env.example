# Optional. Where Luma stores its data (workspaces, tickets, encrypted key). Default: ./.luma
# LUMA_DATA_DIR=./.luma

# Optional. 32+ char secret used to encrypt your Anthropic API key at rest.
# If unset, a random secret is generated once and saved to .luma/secret.key
# LUMA_SECRET=change-me-to-a-long-random-string

# Phase 5 (optional)
# Postgres instead of the JSON file (npm install pg). The JSON data is imported on first start.
# LUMA_DATABASE_URL=postgres://user:pass@localhost:5432/luma
# Process role with Postgres: all (default) | web | worker  (npm run start:web / npm run worker)
# LUMA_ROLE=all
# Memory embeddings: auto (MiniLM if @huggingface/transformers is installed) | minilm | ngram
# LUMA_EMBEDDINGS=auto

# Phase 6 (optional)
# Same value on EVERY Luma process when using Postgres/workers (encrypts keys, tokens, secrets)
# LUMA_SECRET=a-long-random-string
# Workspace files in Postgres (default with LUMA_DATABASE_URL) or on local disk only
# LUMA_FILES=db
# Email (npm install nodemailer): or configure in Settings → Email
# LUMA_SMTP_URL=smtp://user:pass@smtp.example.com:587
# LUMA_MAIL_FROM=Luma AI <luma@example.com>
# LUMA_APP_URL=https://luma.example.com
